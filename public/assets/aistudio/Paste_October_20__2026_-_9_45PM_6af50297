  const mathField = document.getElementById('word-math-field');
  const linearInput = document.getElementById('linear-input');
  const previewBar = document.getElementById('latex-preview-bar');
  let currentMode = 'professional';

  // Hàm vẽ công thức toán bằng KaTeX lên nút bấm
  function renderKatexHTML(latexStr, displayMode = false) {
    try {
      return katex.renderToString(latexStr, {
        throwOnError: false,
        displayMode: displayMode
      });
    } catch (e) {
      return latexStr;
    }
  }

  // 1. Khởi tạo bảng Symbols (8 danh mục)
  function renderSymbolsGallery(categoryKey) {
    const grid = document.getElementById('symbols-grid');
    grid.innerHTML = '';
    const list = WORD_SYMBOLS[categoryKey] || [];
    list.forEach(sym => {
      const btn = document.createElement('button');
      btn.className = 'sym-btn';
      btn.title = 'Chèn ' + sym;
      btn.innerHTML = renderKatexHTML(sym);
      btn.onclick = () => insertTemplate(sym);
      grid.appendChild(btn);
    });
  }

  // 2. Khởi tạo 11 nút Structures kèm Menu thả xuống của Word
  function renderStructuresRibbon() {
    const container = document.getElementById('structures-container');
    container.innerHTML = '';

    WORD_STRUCTURES.forEach(struct => {
      const wrapper = document.createElement('div');
      wrapper.className = 'struct-dropdown' + (struct.alignRight ? ' align-right' : '');

      // Nút bấm chính trên Ribbon
      const trigger = document.createElement('button');
      trigger.className = 'struct-trigger';
      trigger.innerHTML = `
        <div class="struct-icon">${renderKatexHTML(struct.icon)}</div>
        <div class="struct-label">${struct.viTitle}</div>
        <div class="struct-caret">▼</div>
      `;
      trigger.onclick = (e) => {
        e.stopPropagation();
        const isOpen = wrapper.classList.contains('open');
        closeAllDropdowns();
        if (!isOpen) wrapper.classList.add('open');
      };

      // Menu thả xuống chứa các mẫu công thức
      const menu = document.createElement('div');
      menu.className = 'dropdown-menu';
      menu.onclick = (e) => e.stopPropagation();

      struct.sections.forEach(sec => {
        const secTitle = document.createElement('div');
        secTitle.className = 'menu-section-title';
        secTitle.textContent = sec.name;
        menu.appendChild(secTitle);

        const grid = document.createElement('div');
        grid.className = 'template-grid';

        sec.items.forEach(item => {
          const card = document.createElement('button');
          card.className = 'template-card';
          card.innerHTML = `
            <div class="template-preview">${renderKatexHTML(item.preview, true)}</div>
            <div class="template-name">${item.label}</div>
          `;
          card.onclick = () => {
            insertTemplate(item.insert);
            closeAllDropdowns();
          };
          grid.appendChild(card);
        });

        menu.appendChild(grid);
      });

      // Nếu là mục Ma trận, thêm bộ tạo Ma trận kích thước bất kỳ (m x n)
      if (struct.hasCustomMatrix) {
        const customBox = document.createElement('div');
        customBox.className = 'custom-matrix-box';
        customBox.innerHTML = `
          <span>Tùy chỉnh:</span>
          <input type="number" id="mat-rows" value="3" min="1" max="8" title="Số hàng">
          <span>×</span>
          <input type="number" id="mat-cols" value="3" min="1" max="8" title="Số cột">
          <button onclick="insertCustomMatrix()">Chèn Ma trận</button>
        `;
        menu.appendChild(customBox);
      }

      wrapper.appendChild(trigger);
      wrapper.appendChild(menu);
      container.appendChild(wrapper);
    });
  }

  function closeAllDropdowns() {
    document.querySelectorAll('.struct-dropdown.open').forEach(el => el.classList.remove('open'));
  }

  document.addEventListener('click', closeAllDropdowns);

  // Hàm chèn cấu trúc toán học vào vị trí con trỏ
  function insertTemplate(latexTemplate) {
    if (currentMode === 'professional') {
      mathField.executeCommand(['insert', latexTemplate, {
        focus: true,
        feedback: true,
        selectionMode: 'placeholder'
      }]);
      mathField.focus();
      updatePreviewBar(mathField.value);
    } else {
      const clean = latexTemplate.replace(/#\?/g, '{}');
      linearInput.value += ' ' + clean;
      mathField.value = linearInput.value;
      updatePreviewBar(linearInput.value);
      linearInput.focus();
    }
  }

  // Hàm tạo Ma trận động m hàng x n cột
  function insertCustomMatrix() {
    const rows = Math.min(8, Math.max(1, parseInt(document.getElementById('mat-rows').value) || 2));
    const cols = Math.min(8, Math.max(1, parseInt(document.getElementById('mat-cols').value) || 2));
    const rowStr = Array(cols).fill('#?').join(' & ');
    const fullBody = Array(rows).fill(rowStr).join(' \\\\ ');
    insertTemplate(`\\begin{bmatrix} ${fullBody} \\end{bmatrix}`);
    closeAllDropdowns();
  }

  // Chuyển đổi giữa chế độ Professional (Trực quan) và Linear (LaTeX thuần)
  function setMode(mode) {
    currentMode = mode;
    document.getElementById('btn-prof').classList.toggle('active', mode === 'professional');
    document.getElementById('btn-linear').classList.toggle('active', mode === 'linear');
    document.getElementById('mode-indicator').textContent = 'Chế độ: ' + (mode === 'professional' ? 'Professional (Trực quan)' : 'Linear (Mã LaTeX)');

    if (mode === 'linear') {
      linearInput.value = mathField.value;
      mathField.style.display = 'none';
      linearInput.style.display = 'block';
      linearInput.focus();
    } else {
      mathField.value = linearInput.value;
      linearInput.style.display = 'none';
      mathField.style.display = 'block';
      mathField.focus();
    }
  }

  function syncFromLinear() {
    mathField.value = linearInput.value;
    updatePreviewBar(linearInput.value);
  }

  function clearEquation() {
    mathField.value = '';
    linearInput.value = '';
    updatePreviewBar('');
    mathField.focus();
  }

  function updatePreviewBar(val) {
    previewBar.textContent = 'LaTeX Output: ' + val;
  }

  mathField.addEventListener('input', () => {
    updatePreviewBar(mathField.value);
  });

  function submitToAI() {
    const finalLatex = currentMode === 'professional' ? mathField.value : linearInput.value;
    alert('Chuỗi LaTeX chuẩn gửi thẳng vào AI:\n\n$$' + finalLatex + '$$');
  }

  // Khởi chạy giao diện khi tải trang
  window.addEventListener('DOMContentLoaded', () => {
    renderSymbolsGallery('basic');
    renderStructuresRibbon();
  });
</script>

