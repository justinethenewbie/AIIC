            { label: 'Véc-tơ cột [2x1]', preview: '\\begin{bmatrix}\\square\\\\\\square\\end{bmatrix}', insert: '\\begin{bmatrix}#?\\\\#?\\end{bmatrix}' },
            { label: 'Véc-tơ hàng [1x3]', preview: '\\begin{bmatrix}\\square&\\square&\\square\\end{bmatrix}', insert: '\\begin{bmatrix}#?&#?&#?\\end{bmatrix}' }
